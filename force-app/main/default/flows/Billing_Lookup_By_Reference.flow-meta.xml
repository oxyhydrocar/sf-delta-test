<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <label>Billing Lookup By Reference</label>
    <processType>Flow</processType>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <status>Active</status>
    <variables>
        <name>externalRef</name>
        <dataType>String</dataType>
        <isInput>true</isInput>
    </variables>
    <variables>
        <name>requestedOwnerId</name>
        <dataType>String</dataType>
        <isInput>true</isInput>
    </variables>
    <recordLookups>
        <name>Get_Invoice</name>
        <object>Invoice__c</object>
        <filters>
            <field>External_Reference__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>externalRef</elementReference></value>
        </filters>
        <filters>
            <field>OwnerId</field>
            <operator>EqualTo</operator>
            <value><elementReference>requestedOwnerId</elementReference></value>
        </filters>
    </recordLookups>
    <recordCreates>
        <name>Log_Portal_Access</name>
        <object>Billing_Portal_Access_Log__c</object>
    </recordCreates>
    <screens>
        <name>Show_Invoice</name>
        <fields>
            <name>InvoiceAmount</name>
            <fieldType>DisplayText</fieldType>
            <fieldText>Amount: {!Get_Invoice.Amount__c}</fieldText>
        </fields>
    </screens>
</Flow>
