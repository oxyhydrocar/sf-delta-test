<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <label>Export Invoice By Id</label>
    <processType>Flow</processType>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <status>Active</status>
    <variables>
        <name>invoiceId</name>
        <dataType>String</dataType>
        <isInput>true</isInput>
    </variables>
    <recordLookups>
        <name>Get_Invoice_For_Export</name>
        <object>Invoice__c</object>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>invoiceId</elementReference></value>
        </filters>
    </recordLookups>
    <screens>
        <name>Show_Invoice</name>
        <fields>
            <name>InvoiceAmount</name>
            <fieldType>DisplayText</fieldType>
            <fieldText>Amount: {!Get_Invoice_For_Export.Amount__c}</fieldText>
        </fields>
    </screens>
</Flow>
